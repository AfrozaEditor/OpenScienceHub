# ── Service ───────────────────────────────────────────────────────────────
SIMBA_MODE=live
SIMBA_API_KEY=dev-simba-key     # vérifie X-API-Key (même valeur que le backend)
LOG_LEVEL=INFO

# ── Base de données (PostgreSQL + pgvector) ───────────────────────────────
DATABASE_URL=postgresql+psycopg://simba:simba@localhost:5432/simba
DB_SCHEMA=simba

# ── Embeddings (Mistral) ──────────────────────────────────────────────────
EMBEDDING_PROVIDER=mistral
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIM=1024               # doit correspondre à VECTOR(N) en base
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── LLM de génération (Groq principal, fallback Gemini) ──────────────────
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3-32b
LLM_FALLBACKS=gemini             # liste séparée par des virgules
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# ── Extraction académique (GROBID) & OCR ──────────────────────────────────
GROBID_URL=
OCR_ENABLED=true
OCR_LANGUAGES=fra+eng

# ── RAG / chunking ────────────────────────────────────────────────────────
DEFAULT_TOP_K=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
