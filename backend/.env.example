# Django
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver,web,backend

# Base de donnees (PostgreSQL)
DATABASE_URL=postgresql://osh:osh@localhost:5432/osh

# CORS (frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Stockage fichiers
MEDIA_ROOT=media

# Service IA (simba_ia)
SIMBA_IA_URL=http://localhost:8001
SIMBA_API_KEY=dev-simba-key
SIMBA_MODE=mock

# SSI (e-IDStack de IDS)
EIDSTACK_BASE_URL=http://localhost:4000
EIDSTACK_API_KEY=dev-eidstack-key
EIDSTACK_ENVIRONMENT=TEST
EIDSTACK_CREDENTIAL_DEFINITION_ID=
EIDSTACK_CONNECTION_ID=
SSI_MODE=mock

# URL publique de verification (QR)
PUBLIC_VERIFY_BASE_URL=http://localhost:8000/api/v1/verify

# Superuser dev Docker
DJANGO_SUPERUSER_EMAIL=admin@openscience.local
DJANGO_SUPERUSER_PASSWORD=adminpass
